#!/usr/bin/python3
"""nexus-theme: fills the config templates with a theme's colours.

  nexus-theme list                 show installed themes
  nexus-theme current              show the theme in use
  nexus-theme set NAME             switch theme and reload the desktop
  nexus-theme ensure               make sure the current theme's files exist (run at login)
  nexus-theme render NAME OUTDIR   fill the templates into OUTDIR (used by the build check)
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

PLACEHOLDER = re.compile(r"\{\{([a-z0-9_]+)\}\}")
COLOUR = re.compile(r"^#[0-9a-fA-F]{6}$")
TEXT_KEYS = {"name"}


def fail(message):
    print("nexus-theme: " + message, file=sys.stderr)
    sys.exit(1)


def load_theme(share, name):
    path = share / "themes" / name / "theme.conf"
    if not path.is_file():
        fail(f"no theme called '{name}' (looked for {path})")
    values = {}
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            fail(f"{path} line {number}: expected key=value")
        key, value = (part.strip() for part in line.split("=", 1))
        if key in TEXT_KEYS:
            continue
        if not COLOUR.match(value):
            fail(f"{path} line {number}: colour '{key}' must look like #1a2b3c, got '{value}'")
        value = value.lower()
        values[key] = value
        values[key + "_hex"] = value[1:]
        values[key + "_rgb"] = ",".join(str(int(value[i:i + 2], 16)) for i in (1, 3, 5))
    return values


def render(share, name, outdir):
    values = load_theme(share, name)
    templates = sorted(p for p in (share / "templates").iterdir() if p.is_file())
    if not templates:
        fail(f"no templates in {share / 'templates'}")
    rendered = {}
    for template in templates:
        text = template.read_text(encoding="utf-8")
        unknown = sorted({key for key in PLACEHOLDER.findall(text) if key not in values})
        if unknown:
            fail(f"{template.name} uses colours the theme '{name}' does not define: {', '.join(unknown)}")
        rendered[template.name] = PLACEHOLDER.sub(lambda match: values[match.group(1)], text)
    outdir = Path(outdir)
    staging = outdir.with_name(outdir.name + ".new")
    shutil.rmtree(staging, ignore_errors=True)
    staging.mkdir(parents=True)
    for filename, text in rendered.items():
        (staging / filename).write_text(text, encoding="utf-8")
    shutil.rmtree(outdir, ignore_errors=True)
    staging.rename(outdir)


def config_dir():
    return Path(os.environ.get("HOME", "/root")) / ".config" / "nexus"


def default_theme():
    path = Path("/etc/nexus/default-theme")
    if path.is_file():
        name = path.read_text(encoding="utf-8").strip()
        if name:
            return name
    return "tokyo-night"


def current_theme(share):
    saved = config_dir() / "theme"
    if saved.is_file():
        name = saved.read_text(encoding="utf-8").strip()
        if name and (share / "themes" / name / "theme.conf").is_file():
            return name
    return default_theme()


def apply(share, name):
    cfg = config_dir()
    cfg.mkdir(parents=True, exist_ok=True)
    render(share, name, cfg / "current")
    (cfg / "theme").write_text(name + "\n", encoding="utf-8")
    foot = cfg.parent / "foot" / "foot.ini"
    if not foot.exists():
        foot.parent.mkdir(parents=True, exist_ok=True)
        foot.write_text("# Your terminal settings. The colours come from the NEXUS theme.\n"
                        f"[main]\ninclude={cfg / 'current' / 'foot.ini'}\n", encoding="utf-8")


def reload_desktop():
    if not os.environ.get("WAYLAND_DISPLAY"):
        return
    for command in (["hyprctl", "reload"], ["nexus-wallpaper", "apply"], ["nexus-bar", "restart"],
                    ["makoctl", "reload"], ["nexus-osd", "restart"]):
        try:
            subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10, check=False)
        except (OSError, subprocess.TimeoutExpired):
            pass


def main():
    parser = argparse.ArgumentParser(prog="nexus-theme", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--share", default="/usr/share/nexus", help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("list")
    sub.add_parser("current")
    sub.add_parser("ensure")
    p_set = sub.add_parser("set")
    p_set.add_argument("name")
    p_render = sub.add_parser("render")
    p_render.add_argument("name")
    p_render.add_argument("outdir")
    args = parser.parse_args()
    share = Path(args.share)

    if args.command == "list":
        for theme in sorted(p.parent.name for p in (share / "themes").glob("*/theme.conf")):
            print(theme)
    elif args.command == "current":
        print(current_theme(share))
    elif args.command == "render":
        render(share, args.name, args.outdir)
    elif args.command == "ensure":
        apply(share, current_theme(share))
    elif args.command == "set":
        apply(share, args.name)
        reload_desktop()


if __name__ == "__main__":
    main()
