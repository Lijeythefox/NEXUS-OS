# Notifications. Filled in by nexus-theme; do not edit.
font=JetBrains Mono 10
anchor=top-right
margin=14
width=330
padding=12
border-size=2
border-radius=10
default-timeout=5000
max-visible=4
background-color={{surface}}f2
